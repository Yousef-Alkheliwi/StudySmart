# StudySmart reads plain environment variables (there is no .env loader):
# export these in your shell or IDE run configuration before starting it.

# local = ONNX MiniLM sentence embeddings (downloaded once), hashing = no download, off = keyword search only.
STUDYSMART_EMBEDDINGS=local

# Where the SQLite database, uploads, search indexes, vectors and cached model live.
STUDYSMART_DATA_DIR=./data

# HTTP port.
PORT=3939
